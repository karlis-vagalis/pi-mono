{
	"name": "@karlis-vagalis/pi-mono",
	"description": "Extensions for the Pi coding agent.",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.10",
	"license": "MIT",
	"workspaces": [
		"extensions/*"
	],
	"pi": {
		"extensions": [
			"./extensions/*/src/index.ts"
		]
	},
	"engines": {
		"node": ">=22.12",
		"bun": ">=1.3.10"
	},
	"scripts": {
		"check": "biome check . && bun run typecheck && bun run test",
		"typecheck": "bun run --workspaces --if-present typecheck",
		"test": "bun run --workspaces --if-present test",
		"build": "bun run --workspaces --if-present build",
		"dev": "bun run --workspaces --if-present dev",
		"smoke": "bun run --workspaces --if-present smoke",
		"pack:check": "bun run --workspaces --if-present pack:check",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"fix": "biome check --write ."
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^1.4.0",
		"@earendil-works/pi-coding-agent": "^1.4.0",
		"typebox": "^1.4.3",
		"@biomejs/biome": "^2.6.2",
		"@rslib/core": "^1.0.4",
		"@types/bun": "^1.4.3",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2"
	}
}
