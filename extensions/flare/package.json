{
	"name": "@karlis-vagalis/pi-flare",
	"version": "0.0.0",
	"description": "Build small web apps and serve HTML pages, reports, and other browser-ready artifacts from your Pi session.",
	"type": "module",
	"license": "MIT",
	"author": "Kārlis Vagalis",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/karlis-vagalis/pi-mono.git",
		"directory": "extensions/flare"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"celld",
		"microapps",
		"workers"
	],
	"main": "./dist/index.js",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist/",
		"docs/",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.12",
		"bun": ">=1.3.10"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"scripts": {
		"build": "rslib build",
		"dev": "rslib build --watch",
		"check": "biome check . && bun run typecheck && bun run test",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"smoke": "bun run scripts/smoke.ts",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"fix": "biome check --write .",
		"pack:check": "bun pm pack --dry-run --ignore-scripts",
		"prepack": "bun run check && bun run build"
	},
	"dependencies": {
		"@faker-js/faker": "^10.6.0",
		"@hono/node-server": "^2.1.5",
		"chokidar": "^6.0.0",
		"hono": "^4.13.13",
		"zod": "^4.6.7"
	}
}
