{
	"name": "@karlis-vagalis/pi-art-styles",
	"version": "0.0.0",
	"description": "Generate random art-direction prompts.",
	"type": "module",
	"license": "MIT",
	"author": "Kārlis Vagalis",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/karlis-vagalis/pi-mono.git",
		"directory": "extensions/art-styles"
	},
	"keywords": [
		"pi-package",
		"pi-extension"
	],
	"main": "./dist/index.js",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist/",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.12",
		"bun": ">=1.3.10"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"scripts": {
		"build": "rslib build",
		"dev": "rslib build --watch",
		"check": "biome check . && bun run typecheck",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"fix": "biome check --write .",
		"pack:check": "bun pm pack --dry-run --ignore-scripts",
		"prepack": "bun run check && bun run build"
	}
}
